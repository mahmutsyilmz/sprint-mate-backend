# Sprint Mate Backend - Environment Variables
# Copy this file to .env and fill in your values

# GitHub OAuth2 Credentials
# Obtain from: GitHub > Settings > Developer settings > OAuth Apps
# Callback URL (local dev): http://localhost:8080/login/oauth2/code/github
# Callback URL (production): https://<your-railway-domain>/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# AI Service API Keys
CLARIFAI_API_KEY=your-clarifai-api-key
GROQ_API_KEY=your-groq-api-key

# Database Credentials (PostgreSQL)
# Local dev: jdbc:postgresql://localhost:5432/sprintmate
# Neon (free): jdbc:postgresql://<host>.neon.tech/sprintmate?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/sprintmate
DB_USERNAME=postgres
DB_PASSWORD=your-db-password
